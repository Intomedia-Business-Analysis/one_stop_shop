DB_DRIVER=
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_TDS_VERSION=
DB_QUERY_TIMEOUT=

# Session-nøgle (PÅKRÆVET) — appen starter ikke uden. Generér én med:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Sæt til 1 KUN hvis hubben kører bag en reverse proxy (nginx/Caddy/Cloudflare),
# der sætter X-Forwarded-For. Så bruges headeren som klient-IP i login-rate-
# limiteren; uden proxy kan headeren spoofes og må ikke stoles på.
TRUST_PROXY=

# Kun serveren: HTTPS-certifikatet. Tom = almindelig http (lokalt).
HUB_SSL_KEYFILE=
HUB_SSL_CERTFILE=
# Kun serveren: den eksterne adresse bag Azure App Proxy, adskilt med ;
# Uden den afvises login udefra med 403. Tom lokalt.
HUB_TRUSTED_ORIGINS=


# Semikolon-separeret liste af stier til Zuora snapshot mapper
ZUORA_SNAPSHOT_DIR=
USAGE_SNAPSHOT_DIR=

# ── Administrative nysalg (modul_admin_nysalg) ──────────────────────
# Standardsti til Zuora ARR-bevægelsesudtrækket (kan overstyres i UI'en;
# alternativt uploades filen direkte). Tom = kræver upload.
ADMIN_NYSALG_EXTRACT_PATH=
# Mappe hvor de genererede rapporter (Excel/PDF) gemmes.
# Default: data/admin_nysalg_reports
ADMIN_NYSALG_REPORT_DIR=

# ── Retention v2 (modul_retention_v2) ───────────────────────────────
# Mappen med CSV-udtrækkene (20_konti, 21_abonnementer, 22_forbrug),
# en ny fil med datostempel pr. udtræk. Tom = Operations - Dokumenter\Business
# Analysis\Retention_v2 under brugerens mappe.
RETENTION_V2_DATA_DIR=

# Pipedrive API-tokens — bruges af Portfolio Alignment til at oprette
# afstemnings-deals ("Porteføljeafstemning 2026") direkte fra UI'en.
PD_TOKEN_WATCH_DK_FINANS=
PD_TOKEN_WATCH_NO=
PD_TOKEN_WATCH_SE=
PD_TOKEN_WATCH_DE=
PD_TOKEN_MONITOR=
# JP/POL Advertising — bruges af Klippekort Overblik til at opdatere
# feltet "klip brugt" (used_clip_cards) på job-deals via Pipedrive API.
PD_TOKEN_JPPOL=

# ── Barselsplanlægger: mail-notifikation ved godkendelse ────────────
# Microsoft 365 SMTP er default. Hvis SMTP_USER eller SMTP_PASSWORD
# er tomme, springes afsendelsen over uden fejl (godkendelsen står ved magt).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_USE_TLS=1
# Hvis du får CERTIFICATE_VERIFY_FAILED (virksomhedsproxy/TLS-inspektion):
#   - peg på en CA-bundle, fx Zscaler-rootcert: SMTP_CA_BUNDLE=C:/certs/zscaler-root.pem
#   - eller spring verificering over som lynfix:   SMTP_SSL_VERIFY=0
SMTP_CA_BUNDLE=
SMTP_SSL_VERIFY=1